# External hosted MySQL for Vercel. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Always true for a production external database. Local Docker only: false.
DATABASE_SSL=true
# Optional PEM CA certificate if the database provider uses a private CA.
DATABASE_CA=
APP_URL=http://localhost:3000
# Optional: Vercel Blob store token. Uploads require persistent storage.
BLOB_READ_WRITE_TOKEN=
# Optional: HTTPS payment verification API. See VERCEL.md for response format.
PAYMENT_VERIFY_URL=
PAYMENT_API_KEY=
