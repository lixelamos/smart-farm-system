# Set these on the PHP host; do not put credentials inside the public directory.
PHP_API_KEY=REPLACE_WITH_THE_SAME_RANDOM_64_CHARACTER_KEY_AS_VERCEL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD=
DB_SSL=false
DB_CA_FILE=
# Absolute persistent directory OUTSIDE the public document root.
UPLOAD_DIR=/srv/smart-farm-uploads
PAYMENT_VERIFY_URL=
PAYMENT_API_KEY=
